# Copy this file to .env and replace every placeholder.
# Never commit .env or use development credentials in production.

POSTGRES_PASSWORD=replace-with-a-local-database-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_JWT_SECRET_KEY=replace-with-a-different-32-character-secret

# Local development wallet only. Never use or fund production wallets here.
CRYPTO_HD_WALLET_SEED_PHRASE=replace-with-a-local-development-seed-phrase
CRYPTO_HOT_WALLET_ADDRESS=replace-with-a-local-development-address
CRYPTO_TREASURY_ADDRESS=replace-with-a-different-local-development-address

AFRICASTALKING_API_KEY=replace-after-creating-the-sandbox-account
RESEND_API_KEY=replace-with-your-resend-api-key
COINGECKO_API_KEY=replace-with-your-coingecko-api-key
